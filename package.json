{
  "name": "cdinnov-application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node platform/build.mjs",
    "typecheck": "tsc -p platform/tsconfig.json",
    "test:platform": "node platform/test.mjs",
    "test:dashboard": "node platform/dashboard-test.mjs",
    "test:finance": "node platform/finance-test.mjs",
    "test:markets": "node marches/test.mjs && node marches/ai-test.mjs",
    "test:agenda": "node --test agenda/leave-periods.test.mjs",
    "test:agenda:browser": "node platform/agenda-browser-test.mjs",
    "test:personnel": "node platform/personnel-test.mjs",
    "build:budgets": "node apps/build.mjs",
    "typecheck:budgets": "tsc -p apps/budgets/tsconfig.json",
    "test:applications:browser": "node platform/applications-browser-test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "xlsx": "0.18.5"
  }
}
